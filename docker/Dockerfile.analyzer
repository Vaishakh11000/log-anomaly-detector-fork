# The heavy half of the collector/analyzer split (CLAUDE.md 2c/2d).
#
# This image runs the full detection stack: it tails the shared collector file,
# scores it, and serves incidents over HTTP. It is deliberately the big one --
# torch (CPU), sentence-transformers, scikit-learn -- which is exactly why the
# receiver was split out into its own small container. Build is slow the first
# time because the CPU torch wheel is large; that cost lives here and nowhere
# near the collector.
FROM python:3.12-slim

# uv only (CLAUDE.md section 2). Copied from the official image rather than
# curl-installed so the build is reproducible.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV LOGDET_PROJECT_ROOT=/app \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1

# Dependency layer first, so a source-only edit does not re-resolve torch.
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
RUN uv sync --frozen --no-dev

# The auto-start entrypoint boots the API and then points a follow-stream at
# the shared collector file, so an analyzer that comes up (or restarts) starts
# reading whatever the collector has buffered without a manual /stream/start.
COPY docker/analyzer-entrypoint.sh /usr/local/bin/analyzer-entrypoint.sh
RUN chmod +x /usr/local/bin/analyzer-entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/analyzer-entrypoint.sh"]
