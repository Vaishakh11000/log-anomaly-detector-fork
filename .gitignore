.venv/
__pycache__/
*.pyc
.pytest_cache/
data/processed/*
!data/processed/.gitkeep
.env

# LogHub corpora: 73MB of downloaded third-party data, regenerable via
# `uv run logdet-fetch-data`. The fetcher pins a Zenodo record and verifies
# SHA-256, so the corpus is reproducible without committing it.
data/external/

# detached benchmark run logs
.run/

# in-progress kill-point checkpoints (transient; deleted on successful completion)
results/**/*.partial.json

# Fitted detectors (regenerable; provenance is in the file itself)
models/

# Demo replay output: logdet-replay rewrites a recorded corpus into here, so it
# is regenerable and changes every run.
data/live/

# Parsed intermediates written beside a report (regenerable from the raw log by
# re-running the report; the report itself is the artifact worth keeping).
results/**/parsed_templates.csv
